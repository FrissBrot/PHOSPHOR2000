# Network/election + clock sync + replication + API/WebSocket server (one asyncio process;
# nmcli runs on a worker thread so it can never stall the tick or the renderer feed).
[Unit]
Description=PHOSPHOR2000 core (network, sync, server)
After=NetworkManager.service
Wants=NetworkManager.service
PartOf=phosphor.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# hang detection: the service must send a heartbeat (sd_notify WATCHDOG=1)
WatchdogSec=30
TimeoutStartSec=120
User=phosphor
Group=phosphor
SupplementaryGroups=video
WorkingDirectory=/opt/phosphor2000
Environment=PYTHONUNBUFFERED=1 PHOSPHOR_ETC=/etc/phosphor2000 PHOSPHOR_STATE=/var/lib/phosphor2000 PHOSPHOR_RUN=/run/phosphor2000
ExecStart=/opt/phosphor2000/venv/bin/python -m backend.services.core
Restart=always
RestartSec=2
RuntimeDirectory=phosphor2000
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=phosphor2000
# Timing matters more than throughput: modest real-time-ish priority, never RT.
Nice=-5
CPUAffinity=0 1 2
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/phosphor2000 /run/phosphor2000

[Install]
WantedBy=phosphor.target
