[Unit]
Description=PHOSPHOR2000 audio engine (USB line-in beat tracking)
After=phosphor-core.service sound.target
PartOf=phosphor.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=phosphor
Group=phosphor
SupplementaryGroups=audio
WorkingDirectory=/opt/phosphor2000
Environment=PYTHONUNBUFFERED=1 PHOSPHOR_ETC=/etc/phosphor2000 PHOSPHOR_RUN=/run/phosphor2000
ExecStart=/opt/phosphor2000/venv/bin/python -m backend.audio.service
Restart=always
RestartSec=3
Nice=-10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/phosphor2000

[Install]
WantedBy=phosphor.target
