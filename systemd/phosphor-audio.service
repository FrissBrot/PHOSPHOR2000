[Unit]
Description=PHOSPHOR2000 audio engine (USB line-in beat tracking)
After=phosphor-core.service sound.target
PartOf=phosphor.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# hang detection: the service must send a heartbeat (sd_notify WATCHDOG=1)
WatchdogSec=20
TimeoutStartSec=120
User=phosphor
Group=phosphor
SupplementaryGroups=audio
WorkingDirectory=/opt/phosphor2000
Environment=PYTHONUNBUFFERED=1 PHOSPHOR_ETC=/etc/phosphor2000 PHOSPHOR_RUN=/run/phosphor2000
ExecStart=/opt/phosphor2000/venv/bin/python -m backend.audio.service
Restart=always
RestartSec=3
# Core 3 is reserved for audio capture/analysis; real-time round-robin scheduling so Chromium
# or the core can never starve the capture thread (the analysis itself uses ~15 % of a Pi 3 core).
CPUAffinity=3
CPUSchedulingPolicy=rr
CPUSchedulingPriority=20
LimitRTPRIO=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/phosphor2000

[Install]
WantedBy=phosphor.target
