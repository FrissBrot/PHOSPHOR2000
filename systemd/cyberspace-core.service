# Network/election + clock sync + replication + API/WebSocket server (one asyncio process;
# nmcli runs on a worker thread so it can never stall the tick or the renderer feed).
[Unit]
Description=CYBERSPACE 2000 core (network, sync, server)
After=NetworkManager.service
Wants=NetworkManager.service
PartOf=cyberspace.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=cyberspace
Group=cyberspace
SupplementaryGroups=video
WorkingDirectory=/opt/cyberspace2000
Environment=PYTHONUNBUFFERED=1 CYBERSPACE_ETC=/etc/cyberspace2000 CYBERSPACE_STATE=/var/lib/cyberspace2000 CYBERSPACE_RUN=/run/cyberspace2000
ExecStart=/opt/cyberspace2000/venv/bin/python -m backend.services.core
Restart=always
RestartSec=2
RuntimeDirectory=cyberspace2000
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=cyberspace2000
# Timing matters more than throughput: modest real-time-ish priority, never RT.
Nice=-5
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/cyberspace2000 /run/cyberspace2000
WatchdogSec=0

[Install]
WantedBy=cyberspace.target
