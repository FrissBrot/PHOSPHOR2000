# Optional: restrict CYBERSPACE ports to the cluster subnet and loopback (separate nft table,
# does not touch other rules). Enabled by install.sh --firewall.
[Unit]
Description=CYBERSPACE 2000 firewall table
After=network-pre.target
Before=cyberspace-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /opt/cyberspace2000/systemd/cyberspace.nft
ExecStop=/usr/sbin/nft delete table inet cyberspace

[Install]
WantedBy=multi-user.target
