# Chromium kiosk inside the cage Wayland compositor on tty1 (no desktop needed).
[Unit]
Description=CYBERSPACE 2000 renderer (cage + Chromium kiosk)
After=cyberspace-core.service systemd-user-sessions.service plymouth-quit-wait.service
Wants=cyberspace-core.service
Conflicts=getty@tty1.service
After=getty@tty1.service
PartOf=cyberspace.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=cyberspace
PAMName=cyberspace-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/bin/cage -d -- /opt/cyberspace2000/scripts/kiosk-launch.sh
Restart=always
RestartSec=3

[Install]
WantedBy=cyberspace.target
