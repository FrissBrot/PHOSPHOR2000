[Unit]
Description=CYBERSPACE 2000 keyboard (evdev, monotonic timestamps) for calibration
After=cyberspace-core.service
PartOf=cyberspace.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=cyberspace
Group=cyberspace
SupplementaryGroups=input
WorkingDirectory=/opt/cyberspace2000
Environment=PYTHONUNBUFFERED=1 CYBERSPACE_RUN=/run/cyberspace2000
ExecStart=/opt/cyberspace2000/venv/bin/python -m backend.services.input_service
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/cyberspace2000

[Install]
WantedBy=cyberspace.target
